generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  title            String
  slug             String         @unique
  description      String?
  thumbnail        String?
  published        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String         @db.Uuid
  avgRating        Float          @default(0)
  discount         Decimal?       @db.Decimal(10, 2)
  duration         String?
  hasCertificate   Boolean        @default(true)
  hasExam          Boolean        @default(false)
  level            Level          @default(BEGINNER)
  price            Decimal        @default(0) @db.Decimal(10, 2)
  studentNumber    Int            @default(0)
  careerFields     String[]       @default([])
  learningOutcomes String[]       @default([])
  overview         String?
  conductingType   ConductingType @default(Online)
  estimatedSalary  String?
  expectedIncome   String?
  growthPercentage Float?
  hiringSectors    String[]       @default([])

  instructorId String // Matches User id type (String/cuid)
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  certificates    Certificate[]
  category        Category         @relation(fields: [categoryId], references: [id])
  courseProgress  CourseProgress[]
  enrollments     Enrollment[]
  faqs            FAQ[]
  learnerStories  LearnerStory[]
  syllabus        Module[]
  quizzes         Quiz[]
  quizSubmissions QuizSubmission[]
  reviews         Review[]
  tags            Tag[]            @relation("CourseToTag")
}

model Tag {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique
  courses Course[] @relation("CourseToTag")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating    Int      @default(5)
  comment   String?
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

model Module {
  title          String
  description    String
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId       String           @db.Uuid
  courseProgress CourseProgress[]
  lessons        Lesson[]
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Quiz           Quiz[]
}

model FAQ {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question String
  answer   String
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LearnerStory {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  role     String?
  story    String
  image    String?
  courseId String  @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         UserRole @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  passwordHash String?

  createdCourses Course[]

  certificates            Certificate[]
  courseProgress          CourseProgress[]
  enrollments             Enrollment[]
  quizSubmissions         QuizSubmission[]
  projectsAsCompany       Project[]                @relation("ProjectCompany")
  projectsAsTalent        Project[]                @relation("ProjectTalent")
  scholarships            Scholarship[]            @relation("ScholarshipDonor")
  scholarshipApplications ScholarshipApplication[] @relation("ScholarshipApplicant")
  reviewedApplications    ScholarshipApplication[] @relation("ScholarshipReviewer")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  courseId String @db.Uuid
  progress Float  @default(0)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CourseProgress {
  id          String   @id @default(cuid())
  userId      String
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  courseId    String   @db.Uuid
  moduleId    String   @db.Uuid
  lessonId    String?  @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lesson {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  slug      String           @unique
  content   Json // Array of content blocks. Each block has a "type" field (ContentType enum) and type-specific fields. Examples: heading (text, level), paragraph (text), list (items[], ordered), image (url, alt, caption), video (url, title, duration), table (headers[], rows[][]), code (code, language), warning/notify (title, text, severity)
  order     Int
  moduleId  String           @db.Uuid
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  progress  CourseProgress[]
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizzes   Quiz[]
}

model Quiz {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  type         AssessmentType   @default(QUIZ)
  passingScore Int              @default(70)
  lessonId     String?          @db.Uuid
  courseId     String           @db.Uuid
  moduleId     String?          @db.Uuid
  questions    Question[]
  course       Course           @relation(fields: [courseId], references: [id])
  lesson       Lesson?          @relation(fields: [lessonId], references: [id])
  Module       Module?          @relation(fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submissions  QuizSubmission[]
}

model Question {
  id      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text    String
  quizId  String       @db.Uuid
  options Option[]
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model Option {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text       String
  isCorrect  Boolean      @default(false)
  questionId String       @db.Uuid
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]
}

model QuizSubmission {
  id        String       @id @default(cuid())
  score     Float
  userId    String
  quizId    String       @db.Uuid
  createdAt DateTime     @default(now())
  courseId  String?      @db.Uuid
  answers   QuizAnswer[]
  course    Course?      @relation(fields: [courseId], references: [id])
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizAnswer {
  id           String         @id @default(cuid())
  submissionId String
  questionId   String         @db.Uuid
  optionId     String         @db.Uuid
  isCorrect    Boolean
  option       Option         @relation(fields: [optionId], references: [id])
  question     Question       @relation(fields: [questionId], references: [id])
  submission   QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique
  issueDate         DateTime @default(now())
  grade             String // e.g., "Distinction" or "Pass"
  finalScore        Float // The calculated weighted average

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // CRITICAL ADDITION: Unique constraint
  @@unique([userId, courseId])
}

model BlogCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]
}

model Blog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  slug           String       @unique
  description    String?
  content        Json
  authorName     String
  readTime       Int
  thumbnail      String?
  published      Boolean      @default(false)
  blogCategoryId String       @db.Uuid
  avgRating      Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  blogCategory   BlogCategory @relation(fields: [blogCategoryId], references: [id])
  blogReviews    BlogReview[]
  blogFaqs       BlogFaq[]
}

model BlogReview {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating        Int      @default(5)
  comment       String?
  reviewerName  String?
  reviewerEmail String?
  blogId        String   @db.Uuid
  createdAt     DateTime @default(now())
  blog          Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model BlogFaq {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question String
  answer   String @db.Text

  // Link to specific blog
  blogId String @db.Uuid
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  slug             String        @unique
  description      String
  budget           Decimal       @db.Decimal(10, 2)
  timeline         String
  skillsRequired   String[]      @default([])
  status           ProjectStatus @default(OPEN)
  companyId        String
  assignedTalentId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        User       @relation("ProjectCompany", fields: [companyId], references: [id])
  assignedTalent User?      @relation("ProjectTalent", fields: [assignedTalentId], references: [id])
  caseStudy      CaseStudy?
}

model CaseStudy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  description    String
  imageUrl       String?
  clientName     String
  projectOutcome String
  projectId      String?  @unique @db.Uuid
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id])
}

model Partnership {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName     String
  contactEmail    String
  contactName     String
  partnershipType PartnershipType
  description     String
  websiteUrl      String?
  status          PartnershipStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Scholarship {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  slug                String          @unique
  description         String
  amount              Decimal         @db.Decimal(10, 2)
  type                ScholarshipType
  eligibilityCriteria Json
  applicationDeadline DateTime
  maxAwards           Int
  awardsGranted       Int             @default(0)
  isActive            Boolean         @default(true)
  donorId             String?
  donorName           String
  donorLogoUrl        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  donor        User?                    @relation("ScholarshipDonor", fields: [donorId], references: [id])
  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId       String            @db.Uuid
  applicantId         String
  motivationLetter    String            @db.Text
  financialNeedProof  String?
  additionalDocuments String[]          @default([])
  status              ApplicationStatus @default(PENDING)
  reviewNotes         String?           @db.Text
  submittedAt         DateTime          @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  applicant   User        @relation("ScholarshipApplicant", fields: [applicantId], references: [id])
  reviewer    User?       @relation("ScholarshipReviewer", fields: [reviewedBy], references: [id])

  @@unique([applicantId, scholarshipId])
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ConductingType {
  Online
  OnSite
  Hybrid
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  CAREER_ADVISOR
  CLIENT
  DONOR
}

enum AssessmentType {
  EXERCISE
  QUIZ
  TEST
  EXAM
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PartnershipType {
  CONTENT_CREATION
  TRAINING
  BOTH
}

enum PartnershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScholarshipType {
  MERIT_BASED
  NEED_BASED
  WOMEN_IN_TECH
  GENERAL
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ContentType {
  HEADING
  PARAGRAPH
  LIST
  IMAGE
  VIDEO
  TABLE
  CODE
  WARNING
  NOTIFY
}

enum BlockSeverity {
  INFO
  WARNING
  DANGER
}
