generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  // 1. Change Course ID to UUID to match the project style
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String  @unique
  description String?
  overview    String? @db.Text
  thumbnail   String?
  published   Boolean @default(false)

  // --- New Details ---
  price          Decimal        @default(0) @db.Decimal(10, 2)
  discount       Decimal?       @db.Decimal(10, 2)
  studentNumber  Int            @default(0)
  duration       String?
  conductingType ConductingType @default(Online)
  hasCertificate Boolean        @default(true)
  hasExam        Boolean        @default(false)
  level          Level          @default(BEGINNER)

  // Market & Career Data (Keep these as simple fields)
  growthPercentage Float?
  expectedIncome   String?
  estimatedSalary  String?
  hiringSectors    String[] @default([])

  // Scalar Arrays for simple lists
  learningOutcomes String[] @default([])
  careerFields     String[] @default([])

  // Relationships
  categoryId     String           @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id])
  tags           Tag[]
  reviews        Review[]
  syllabus       Module[]
  learnerStories LearnerStory[]
  faqs           FAQ[]
  enrollments    Enrollment[]
  courseProgress CourseProgress[]

  avgRating Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique
  courses Course[]
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ConductingType {
  Online
  OnSite
  Hybrid
}

model Review {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating  Int     @default(5) // 1 to 5
  comment String?

  // Relation to Course
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
}

model Module {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String @db.Text

  courseProgress CourseProgress[]

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model FAQ {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question String
  answer   String @db.Text

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LearnerStory {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String
  role  String?
  story String  @db.Text
  image String? // Optional for later use

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// User model with role-based access
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(STUDENT)
  isActive     Boolean  @default(true)

  // Relations
  enrollments    Enrollment[]
  courseProgress CourseProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  CAREER_ADVISOR
}

// Tracks which Student is in which Course
model Enrollment {
  id       String @id @default(cuid())
  userId   String
  // FIX: Added @db.Uuid to match the Course ID type
  courseId String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

// Tracks progress for specific modules within a course
model CourseProgress {
  id          String  @id @default(cuid())
  userId      String
  // FIX: Added @db.Uuid to both fields below
  courseId    String  @db.Uuid
  moduleId    String  @db.Uuid
  isCompleted Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}
