generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Course {
  title            String
  slug             String           @unique
  description      String?
  thumbnail        String?
  published        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String           @db.Uuid
  avgRating        Float            @default(0)
  discount         Decimal?         @db.Decimal(10, 2)
  duration         String?
  hasCertificate   Boolean          @default(true)
  hasExam          Boolean          @default(false)
  level            Level            @default(BEGINNER)
  price            Decimal          @default(0) @db.Decimal(10, 2)
  studentNumber    Int              @default(0)
  careerFields     String[]         @default([])
  learningOutcomes String[]         @default([])
  overview         String?
  conductingType   ConductingType   @default(Online)
  estimatedSalary  String?
  expectedIncome   String?
  growthPercentage Float?
  hiringSectors    String[]         @default([])
  category         Category         @relation(fields: [categoryId], references: [id])
  courseProgress   CourseProgress[]
  enrollments      Enrollment[]
  faqs             FAQ[]
  learnerStories   LearnerStory[]
  syllabus         Module[]
  reviews          Review[]
  tags             Tag[]            @relation("CourseToTag")
}

model Tag {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String   @unique
  courses Course[] @relation("CourseToTag")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rating    Int      @default(5)
  comment   String?
  courseId  String   @db.Uuid
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

model Module {
  title          String
  description    String
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId       String           @db.Uuid
  courseProgress CourseProgress[]
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model FAQ {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question String
  answer   String
  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LearnerStory {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  role     String?
  story    String
  image    String?
  courseId String  @db.Uuid
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  role           UserRole         @default(STUDENT)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  passwordHash   String?
  courseProgress CourseProgress[]
  enrollments    Enrollment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  courseId  String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CourseProgress {
  id          String   @id @default(cuid())
  userId      String
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  courseId    String   @db.Uuid
  moduleId    String   @db.Uuid
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ConductingType {
  Online
  OnSite
  Hybrid
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  CAREER_ADVISOR
}
